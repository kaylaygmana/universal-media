APP_NAME="Universal Media"
APP_ENV=production
# generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-kamu.com
APP_PORT=8000

LOG_CHANNEL=stack
LOG_LEVEL=error

FILESYSTEM_DISK=local
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# DB_* is overridden by docker-compose using the values below
MYSQL_DATABASE=universal-media
MYSQL_APP_USER=universal
MYSQL_APP_PASSWORD=ganti_password_ini
MYSQL_ROOT_PASSWORD=ganti_password_root
DB_FORWARD_PORT=3307
